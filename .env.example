# Copy this file to .env and fill in real values. Never commit .env.

# --- LM Studio (로컬 추론 서버) ---
# LM Studio 의 "Local Server" 탭에서 모델을 로드한 뒤 "Start Server" 로 띄운다.
# 기본 엔드포인트는 http://localhost:1234/v1 이며, 키 검증은 하지 않지만
# openai SDK 가 빈 문자열을 거부하므로 임의 값을 넣어둔다.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
# LM Studio 에 로드된 모델 식별자 (서버 탭 상단에 표시되는 이름과 일치해야 함)
LMSTUDIO_MODEL=qwen3.6-35b-a3b-uncensored-hauhaucs-aggressive

# --- Upbit (가상화폐 시세/체결, read-only 조회만 사용) ---
# 공개 시세 조회는 키 없이도 가능. 잔고 조회 등 사설 엔드포인트 사용 시에만 필요.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# --- DART OpenAPI (한국 전자공시) ---
# https://opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=

# --- Alpha Vantage (해외 주식 보조 시세) ---
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# --- FRED (St. Louis Fed 거시지표) ---
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- 한국은행 ECOS (국내 거시지표) ---
# https://ecos.bok.or.kr/api/
ECOS_API_KEY=

# --- HuggingFace (데이터셋 다운로드, 선택) ---
HF_TOKEN=

# --- 로컬 경로 ---
DATA_DIR=./store
CORPUS_DIR=./corpus
